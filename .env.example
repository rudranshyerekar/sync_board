# ============================================
# SyncBoard — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to source control — it contains secrets.

# -------------------- MySQL Database --------------------

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=syncboard
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# -------------------- Spring Boot --------------------

# Server port (default: 8080)
SERVER_PORT=8080

# Active Spring profile (local / prod)
SPRING_PROFILES_ACTIVE=local

# JPA / Hibernate
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# -------------------- JWT Authentication --------------------

# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Token expiry durations
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# -------------------- Frontend --------------------

# React dev server port
FRONTEND_PORT=3000

# API base URL (used by React to reach the backend)
VITE_API_BASE_URL=http://localhost:8080/api

# WebSocket URL
VITE_WS_URL=http://localhost:8080/ws

# -------------------- CORS --------------------

# Allowed frontend origin(s) for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
